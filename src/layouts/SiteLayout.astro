---
import "../styles/global.css";
import SiteHeader from "../components/react/SiteHeader";
import PhoneWithWhatsApp from "../components/PhoneWithWhatsApp.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { brand, toWhatsAppHref } from "../data/site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {brand.name}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-cdb-white font-sans text-cdb-ink antialiased">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-cdb-yellow focus:px-4 focus:py-2 focus:font-bold"
    >
      Ir para o conteúdo
    </a>
    <SiteHeader client:load />
    <main id="conteudo">
      <slot />
    </main>
    <footer class="border-t border-cdb-purple-soft bg-cdb-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-3">
        <div>
          <a href="/" class="inline-block" aria-label="Caminho do Bem, página inicial">
            <img src="/logo.svg" alt="" width={210} height={74} class="h-14 w-auto" />
          </a>
          <p class="mt-3 max-w-sm text-sm leading-relaxed text-cdb-muted">
            OSC fundada em {brand.foundedYear}. Oficinas, convivência e acesso a direitos em Bagé e Canoas.
          </p>
        </div>
        <div>
          <p class="text-sm font-bold uppercase tracking-wide text-cdb-purple">Sede</p>
          <p class="mt-2 text-sm leading-relaxed text-cdb-ink">
            {brand.address.street}<br />
            {brand.address.extra}<br />
            {brand.address.city}/{brand.address.state} · CEP {brand.address.cep}
          </p>
        </div>
        <div>
          <p class="text-sm font-bold uppercase tracking-wide text-cdb-purple">Fale com a gente</p>
          <ul class="mt-2 space-y-2 text-sm">
            {
              brand.phoneDisplay.map((phone) => (
                <li>
                  <PhoneWithWhatsApp
                    phone={phone}
                    whatsappHref={toWhatsAppHref(phone)}
                    whatsappLabel={`WhatsApp ${phone}`}
                  />
                </li>
              ))
            }
          </ul>
          <div class="mt-4">
            <SocialLinks facebookHref={brand.facebook} instagramHref={brand.instagram} />
          </div>
        </div>
      </div>
      <div class="border-t border-cdb-purple-soft px-4 py-5">
        <p class="text-center text-xs text-cdb-muted">
          Projeto Social Caminho do Bem · Canoas e Bagé · Rio Grande do Sul
        </p>
        <a
          class="mx-auto mt-4 flex min-h-11 max-w-xl items-center justify-center gap-3 text-center text-sm font-semibold text-black underline-offset-4 hover:underline"
          href="https://bambergsoftware.com/"
          rel="noreferrer"
          target="_blank"
        >
          <img
            src="/bamberg.png"
            alt=""
            width="64"
            height="64"
            class="h-14 w-14 shrink-0 object-contain"
          />
          <span>Desenvolvido por Bamberg Desenvolvimento de Software</span>
        </a>
      </div>
    </footer>
  </body>
</html>
