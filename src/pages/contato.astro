---
import SiteLayout from "../layouts/SiteLayout.astro";
import ContactForm from "../components/react/ContactForm";
import { brand } from "../data/site";
---

<SiteLayout
  title="Contato"
  description="Fale com o Projeto Social Caminho do Bem na Sede do Guajuviras, em Canoas."
>
  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-14 lg:grid-cols-[1fr_1fr]">
    <div>
      <p class="text-sm font-bold uppercase tracking-wide text-cdb-purple">Contato</p>
      <h1 class="mt-2 font-display text-5xl text-cdb-purple-deep">A Sede está no Guajuviras.</h1>
      <p class="mt-4 text-lg text-cdb-muted">
        Endereço, telefone e formulário. Se o e-mail do aplicativo não abrir, use o WhatsApp.
      </p>
      <address class="mt-8 not-italic leading-relaxed text-cdb-ink">
        {brand.address.street}<br />
        {brand.address.extra}<br />
        {brand.address.city}/{brand.address.state} · CEP {brand.address.cep}
      </address>
      <ul class="mt-6 space-y-2">
        {
          brand.phoneDisplay.map((phone) => (
            <li>
              <a class="font-bold text-cdb-purple" href={`tel:+55${phone.replace(/\D/g, "")}`}>
                {phone}
              </a>
            </li>
          ))
        }
        <li>
          <a class="font-bold text-cdb-purple" href={brand.instagram}>Instagram @caminhodobemofc</a>
        </li>
        <li>
          <a class="font-bold text-cdb-purple" href={brand.linkedin}>LinkedIn</a>
        </li>
      </ul>
    </div>
    <div class="rounded-[2rem] border border-cdb-purple-soft bg-cdb-paper p-6">
      <h2 class="font-display text-3xl text-cdb-purple-deep">Escreva para a equipe</h2>
      <div class="mt-6">
        <ContactForm client:load />
      </div>
    </div>
  </section>
</SiteLayout>
